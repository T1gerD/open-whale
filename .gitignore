# Dependencies — the plugin and protocol ship with zero runtime dependencies on
# purpose, and the mobile app's dependencies are installed by `pnpm install`.
node_modules/
.pnpm-store/

# Test runner scratch output (one log per suite when run through
# scripts/run-tests.mjs).
.test-logs/

# Native build output for the mobile app
packages/mobile/android/
packages/mobile/ios/
packages/mobile/.expo/
packages/mobile/dist/
*.apk
*.aab
*.keystore

# Locally built release artifacts (scripts/build-plugin-package.mjs, expo builds).
# The published copies live on the GitHub Release, not in the source tree.
release/

# Plugin runtime state, if someone runs the plugin from a checkout
openwhale.log
state.json
uploads/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-error.log*

# A `.gitattributes` in this repository pins `src/protocol.mjs` to LF on checkout.
# It has to: the file is a *generated copy* whose sha256 is asserted against the
# authoritative source, and Git's default `core.autocrlf` behaviour on Windows would
# rewrite its line endings on checkout and break that assertion (observed on Windows
# CI). Do not add other rules there without keeping that one.
