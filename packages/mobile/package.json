{
  "name": "@openwhale/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Open Whale 手机端：扫码绑定电脑上的 dsh-openwhale 插件，以个人助理聊天的方式远程使用 DSH。",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
