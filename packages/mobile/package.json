    "check": "node scripts/check-syntax.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.28.0",
    "@openwhale/protocol": "workspace:*",
    "babel-preset-expo": "~57.0.15",
    "expo": "~57.0.28",
    "expo-camera": "~57.0.6",
    "expo-constants": "*",
    "expo-crypto": "*",
    "expo-document-picker": "*",
    "expo-file-system": "~57.0.7",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "*",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=22.11"
