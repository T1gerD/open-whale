{
  "name": "open-whale",
  "private": true,
  "version": "2.2.0",
  "description": "手机上的个人助理，远程使用电脑上的 DeepSeek Harness —— DSH 插件 + Expo 手机应用 + 鸿蒙/iOS 可用的网页版",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:protocol": "node packages/protocol/test/protocol.test.mjs",
    "test:plugin": "node scripts/run-tests.mjs packages/plugin",
    "test:mobile": "node packages/mobile/test/run.mjs",
    "test:webchat": "node scripts/run-tests.mjs packages/webchat",
    "sync:protocol": "node packages/plugin/scripts/sync-protocol.mjs",
    "build:plugin": "node scripts/build-plugin-package.mjs",
    "build:npm": "node scripts/build-plugin-package.mjs --npm-dir",
    "verify:plugin-package": "node scripts/build-plugin-package.mjs --check",
    "verify:install": "node scripts/verify-install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.0"
}
